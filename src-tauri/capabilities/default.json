{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.warframe.market/v2/*"
        },
        {
          "url": "https://data.jsdelivr.com/v1/packages/npm/@wfcd/*"
        },
        {
          "url": "https://cdn.jsdelivr.net/npm/@wfcd/*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "https://api.warframe.com/cdn/*"
        }
      ]
    },

    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPCACHE/**" }]
    },
    "screenshots:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "dialog:allow-open"
  ]
}
